# =============================================================================
# connect_voice_simulated/.env.example
# =====================================
# SINGLE SOURCE OF TRUTH for all project variables.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  Local dev  →  copy this file to .env and fill in your values           │
# │  CI/CD      →  add each variable to GitHub Settings once (see column 3) │
# │               The workflow auto-generates .env from those at runtime    │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Variable                    GitHub Settings location
# ──────────────────────────  ────────────────────────────────────────
# AWS_REGION                  Settings → Variables    → AWS_REGION
# CONNECT_INSTANCE_ID         Settings → Variables    → CONNECT_INSTANCE_ID
# CONNECT_INSTANCE_ALIAS      Settings → Variables    → CONNECT_INSTANCE_ALIAS
# AWS_ROLE_SESSION_NAME       Settings → Variables    → AWS_ROLE_SESSION_NAME
# CONNECT_PHONE_NUMBER        Settings → Variables    → CONNECT_PHONE_NUMBER
# CONNECT_MAIN_FLOW_ID        Settings → Variables    → CONNECT_MAIN_FLOW_ID
# CONNECT_LOAN_FLOW_ID        Settings → Variables    → CONNECT_LOAN_FLOW_ID
# CONNECT_DISPUTE_FLOW_ID     Settings → Variables    → CONNECT_DISPUTE_FLOW_ID
# CONNECT_GENERAL_QUEUE_ID    Settings → Variables    → CONNECT_GENERAL_QUEUE_ID
# CONNECT_GOLD_QUEUE_ID       Settings → Variables    → CONNECT_GOLD_QUEUE_ID
# CONNECT_OUTPUT_DIR          (set by workflow automatically)
# CONNECT_CONCURRENCY         (set by workflow automatically from dispatch input)
#
# AWS_ROLE_ARN is a SECRET – it must NEVER appear in this file or .env.
# For local dev use ~/.aws/credentials / SSO. For CI it goes in:
#   GitHub Settings → Secrets and variables → Secrets → AWS_ROLE_ARN
# =============================================================================

AWS_REGION=eu-west-2

CONNECT_INSTANCE_ID=REPLACE_WITH_YOUR_CONNECT_INSTANCE_UUID
CONNECT_INSTANCE_ALIAS=REPLACE_WITH_YOUR_INSTANCE_ALIAS

# Session name appears in CloudTrail / STS logs – cosmetic but useful
AWS_ROLE_SESSION_NAME=connect-voice-test-runner

CONNECT_OUTPUT_DIR=test-results
CONNECT_CONCURRENCY=5

CONNECT_PHONE_NUMBER=+44REPLACE_WITH_YOUR_DID
CONNECT_MAIN_FLOW_ID=REPLACE_WITH_YOUR_MAIN_IVR_FLOW_ID
CONNECT_LOAN_FLOW_ID=REPLACE_WITH_YOUR_LOAN_FLOW_ID
CONNECT_DISPUTE_FLOW_ID=REPLACE_WITH_YOUR_DISPUTE_FLOW_ID
CONNECT_GENERAL_QUEUE_ID=REPLACE_WITH_YOUR_GENERAL_QUEUE_ID
CONNECT_GOLD_QUEUE_ID=REPLACE_WITH_YOUR_GOLD_QUEUE_ID

# Optional polling tuning
# CONNECT_POLL_INTERVAL_SECONDS=5
# CONNECT_MAX_POLL_ATTEMPTS=60
